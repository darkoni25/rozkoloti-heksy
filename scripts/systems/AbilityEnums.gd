class_name AbilityEnums
## Спільні enum-и для всієї системи здібностей.
## Цей файл не має залежностей — безпечно імпортувати звідусіль.
##
## Використання:
##   AbilityEnums.TargetMode.ALLY_NEAR
##   AbilityEnums.EffectType.DAMAGE

# ── Режими прицілювання ───────────────────────────────────────────────────────
## Визначає ЯК гравець обирає ціль (UI-рівень).
enum TargetMode {
	SELF,         ## без вибору цілі — виконується одразу при натисканні кнопки
	ALLY_NEAR,    ## клікнути на союзника у радіусі range
	ENEMY_NEAR,   ## клікнути на ворога у радіусі range
	ANY_HEX,      ## клікнути на будь-який гекс у радіусі (для AoE з центром)
	EMPTY_HEX,    ## клікнути на порожній гекс (пастки, заклик, телепорт)
	ALLY_OR_SELF, ## клікнути на союзника АБО на самого себе
}

# ── Типи ефектів ──────────────────────────────────────────────────────────────
## Визначає ЩО робить один ефект навички.
## Нові типи додавати тільки коли з'являється НОВА механіка.
enum EffectType {
	DAMAGE,      ## урон одній цілі (ворог у target_hex)
	HEAL,        ## лікування одній цілі (союзник у target_hex)
	SELF_HEAL,   ## лікування актора
	SELF_DAMAGE, ## урон актору (для навичок з жертвою)
	AOE_DAMAGE,  ## урон усім у радіусі від target_hex
	AOE_HEAL,    ## лікування союзників у радіусі від actor.hex
}
